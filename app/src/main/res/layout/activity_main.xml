<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icone"
            android:padding="10dp"
            android:src="@drawable/ic_fitness"
            android:tint="@color/vinho" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="14dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtSubtitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/salmao_claro"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include android:id="@+id/telaRegistrar" layout="@layout/tela_registrar" />
        <include android:id="@+id/telaRelatorio" layout="@layout/tela_relatorio" />
        <include android:id="@+id/telaBackup" layout="@layout/tela_backup" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/borda" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/branco"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/tabRegistrar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconeRegistrar"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_add" />
            <TextView
                android:id="@+id/rotuloRegistrar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_registrar"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRelatorio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconeRelatorio"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_chart" />
            <TextView
                android:id="@+id/rotuloRelatorio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_relatorio"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabBackup"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:gravity="center"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/iconeBackup"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_backup" />
            <TextView
                android:id="@+id/rotuloBackup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/tab_backup"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
